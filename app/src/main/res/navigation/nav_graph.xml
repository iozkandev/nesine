<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/chooserFragment">

    <!-- Landing screen: choose Views or Compose. -->
    <fragment
        android:id="@+id/chooserFragment"
        android:name="com.iozkan.nesineapp.presentation.chooser.ChooserFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_chooser">

        <action
            android:id="@+id/action_chooser_to_views"
            app:destination="@id/postListFragment" />
        <action
            android:id="@+id/action_chooser_to_compose"
            app:destination="@id/composeHostFragment" />
    </fragment>

    <!-- ===== Views (MVVM) flow ===== -->
    <fragment
        android:id="@+id/postListFragment"
        android:name="com.iozkan.nesineapp.presentation.list.PostListFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_post_list">

        <action
            android:id="@+id/action_list_to_detail"
            app:destination="@id/postDetailFragment" />
    </fragment>

    <dialog
        android:id="@+id/postDetailFragment"
        android:name="com.iozkan.nesineapp.presentation.detail.PostDetailFragment"
        android:label="@string/detail_title"
        tools:layout="@layout/fragment_post_detail">

        <argument
            android:name="postId"
            app:argType="integer" />
    </dialog>

    <!-- ===== Compose (MVI) flow — hosts its own Navigation-Compose graph ===== -->
    <fragment
        android:id="@+id/composeHostFragment"
        android:name="com.iozkan.nesineapp.presentation.compose.ComposeHostFragment"
        android:label="@string/app_name" />

</navigation>
